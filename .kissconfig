# kiss (https://github.com/dsweet99/kiss) thresholds for `kiss check`.
# Only the static checks are used; tests run through plain `cargo test`.
#
# Policy: values start at kiss's defaults (with the few deliberate deviations
# noted inline). Thresholds may be tightened as the code settles; loosening one
# is a design discussion, not a fix for a failing check.

[global]
min_similarity = 0.9
duplication_enabled = true          # default off; on so copy-pasted stage code gets flagged
orphan_module_enabled = true        # default off; every module must be reachable from main
comment_removal_enabled = false
docs_allowed = ["./"]
orphan_allowed = []

[rust]
statements_per_function = 35
arguments = 6                       # default 8; was 4 (a stage gets (doc, ctx) and helpers should stay small) until read-fonts' CommandSink::curve_to, six arguments, had to be implemented; nothing of ours takes more than 4
max_indentation = 4                 # default 5
nested_function_depth = 2
returns_per_function = 5
branches_per_function = 9
local_variables = 20
boolean_parameters = 1
attributes_per_function = 1
calls_per_function = 45
methods_per_class = 10
statements_per_file = 250
lines_per_file = 900
functions_per_file = 40
interface_types_per_file = 1        # default 0; pipeline.rs defines the Stage trait
concrete_types_per_file = 8
imported_names_per_file = 50
indirect_dependencies = 10
dependency_depth = 3
cycle_size = 0
